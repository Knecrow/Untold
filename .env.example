# Turso (LibSQL) credentials
# Get these from: https://turso.tech → your database → Connect

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ── Local dev only (no Turso account needed) ──────────────────────────────────
# To use an in-memory local SQLite DB instead, set:
# TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=   (leave blank)
